[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

3d_physics/layer_1="Objects"
3d_physics/layer_2="Player"

[locale]

fallback="ru"
translations=PoolStringArray( "res://UserInterfase/Localizations/Localizations.en.translation", "res://UserInterfase/Localizations/Localizations.ru.translation", "res://UserInterfase/Localizations/Localizations.tr.translation" )
locale_filter=[ 1, [ "en", "ru", "tr" ] ]

[mono]

project/assembly_name="First Person Starter"

[physics]

common/enable_pause_aware_picking=true

[rendering]

quality/driver/driver_name="GLES2"
vram_compression/import_etc=true
environment/default_clear_color=Color( 0, 0, 0, 1 )
environment/default_environment="res://Levels/Main/default_env.tres"
