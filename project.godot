; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

_global_script_classes=[ {
"base": "Node",
"class": "AudioManager",
"language": "GDScript",
"path": "res://Managers/AudioManager.gd"
}, {
"base": "Area",
"class": "CraftPortal",
"language": "GDScript",
"path": "res://Levels/Main/Portal.gd"
}, {
"base": "Resource",
"class": "CraftResource",
"language": "GDScript",
"path": "res://Crafts/craft_resource.gd"
}, {
"base": "Node",
"class": "CraftsManager",
"language": "GDScript",
"path": "res://Managers/CraftsManager.gd"
}, {
"base": "Panel",
"class": "IncorrectPanel",
"language": "GDScript",
"path": "res://UserInterfase/IncorrectPanel.gd"
}, {
"base": "KinematicBody",
"class": "MovementController",
"language": "GDScript",
"path": "res://Player/MovementController.gd"
}, {
"base": "Label",
"class": "NotificationLabel",
"language": "GDScript",
"path": "res://UserInterfase/NotificatoinLabel.gd"
} ]
_global_script_class_icons={
"AudioManager": "",
"CraftPortal": "",
"CraftResource": "",
"CraftsManager": "",
"IncorrectPanel": "",
"MovementController": "",
"NotificationLabel": ""
}

[addons]

instant_games_bridge/general/game_distribution_game_id=""
instant_games_bridge/general/vk_play_game_id=""

[application]

config/name="GuessAllCrafts"
run/main_scene="res://Levels/Main/L_Main.tscn"

[audio]

output_latency.web=150

[autoload]

Bridge="*res://addons/instant_games_bridge/bridge.gd"
BridgeManager="*res://Managers/BridgeManager.gd"
GameManager="*res://Managers/GameManager.gd"
Localization="*res://UserInterfase/Localizations/Localization.gd"

[display]

window/size/width=1920
window/size/height=1080
window/size/fullscreen=true
window/dpi/allow_hidpi=true
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[editor]

convert_text_resources_to_binary_on_export=true

[editor_plugins]

enabled=PoolStringArray( "res://addons/instant_games_bridge/plugin.cfg" )

[gui]

common/drop_mouse_on_gui_input_disabled=true
theme/use_hidpi=true

